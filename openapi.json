{
  "openapi": "3.1.0",
  "info": {
    "title": "Tawfeer Hub Coupons API",
    "version": "1.0.0",
    "description": "Active discount codes for Noon Egypt, Noon KSA/UAE, DeFacto, Namshi and Mumzworld. The 15 codes in /codes.json were last verified on 2026-11-19; no expiry date is published for any code.",
    "contact": {
      "url": "https://noon-codes.com/"
    }
  },
  "servers": [
    {
      "url": "https://noon-codes.com/"
    }
  ],
  "paths": {
    "/codes.json": {
      "get": {
        "summary": "List coupon codes",
        "operationId": "listCoupons",
        "responses": {
          "200": {
            "description": "Array of coupon codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Coupon"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Coupon": {
        "type": "object",
        "required": [
          "id",
          "store",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "noon-egy-rz46"
          },
          "store": {
            "type": "string",
            "enum": [
              "noon-egypt",
              "noon-ksa-uae",
              "noon-gcc",
              "defacto",
              "namshi",
              "mumzworld"
            ]
          },
          "code": {
            "type": "string",
            "example": "RZ46"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "discount": {
            "type": "string",
            "example": "خصم 10% حتى 50 جنيه"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://www.noon.com/egypt-ar/"
          },
          "terms": {
            "type": "string",
            "example": "حد أدنى للطلب 200 درهم، يعمل 3 مرات فقط لكل عميل طوال الحياة، لا يشمل المناديل والحفاضات والحليب."
          },
          "featured": {
            "type": "boolean"
          },
          "verified": {
            "type": "string",
            "format": "date",
            "example": "2026-11-19"
          }
        }
      }
    }
  }
}
